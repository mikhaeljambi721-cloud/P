                Notify("🖼️ Image Drawer", "URL kosong!")
                return
            end
            local PlayerGui = LP:WaitForChild("PlayerGui")
            local old = PlayerGui:FindFirstChild("SGPT_ImgDrawer")
            if old then old:Destroy() end
            
            local sg = Instance.new("ScreenGui")
            sg.Name = "SGPT_ImgDrawer"; sg.ResetOnSpawn = false
            sg.IgnoreGuiInset = true; sg.Parent = PlayerGui
            
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(0, 300, 0, 300)
            frame.Position = UDim2.new(0.5, 0, 0.5, 0)
            frame.AnchorPoint = Vector2.new(0.5, 0.5)
            frame.BackgroundColor3 = Color3.fromRGB(20,20,25)
            frame.Active = true; frame.Draggable = true
            frame.Parent = sg
            
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0,12)
            local stroke = Instance.new("UIStroke", frame)
            stroke.Color = Color3.fromRGB(80,80,100); stroke.Thickness = 2
            
            local img = Instance.new("ImageLabel")
            img.Size = UDim2.new(1,-10,1,-10)
            img.Position = UDim2.new(0.5,0,0.5,0)
            img.AnchorPoint = Vector2.new(0.5,0.5)
            img.BackgroundTransparency = 1
            img.Image = url; img.ScaleType = Enum.ScaleType.Fit
            img.Parent = frame
            Instance.new("UICorner", img).CornerRadius = UDim.new(0,10)
            
            local close = Instance.new("TextButton")
            close.Size = UDim2.new(0,30,0,30)
            close.Position = UDim2.new(1,5,0,-5)
            close.BackgroundColor3 = Color3.fromRGB(220,50,50)
            close.Text = "✕"; close.TextColor3 = Color3.fromRGB(255,255,255)
            close.TextSize = 18; close.Font = Enum.Font.GothamBold
            close.BorderSizePixel = 0; close.Parent = frame
            Instance.new("UICorner", close).CornerRadius = UDim.new(0,15)
            close.MouseButton1Click:Connect(function() sg:Destroy() end)
            
            Notify("🖼️ Image Drawer", "Gambar ditampilkan!")
        end
    })
    Tab:CreateSection("Info")
    Tab:CreateParagraph({
        Title = "Cara Pakai",
        Content = "Paste URL gambar direct (.png/.jpg/.gif).\nKlik Tampilkan. Gambar bisa di-drag."
    })
end

