-- ============================================
--  🔍 DETEKSI GAME
-- ============================================

local function DetectGame()
    local placeId = game.PlaceId
    local gameData = GAME_DB[placeId]
    
    if not gameData then
        -- Cek dari nama game
        local success, info = pcall(function()
            return game:GetService("MarketplaceService"):GetProductInfo(placeId)
        end)
        
        if success and info then
            local name = info.Name:lower()
            if name:find("blox") and name:find("fruit") then
                return {name = "Blox Fruits (Detected)", module = "bloxfruits"}
            elseif name:find("steal") and name:find("egg") then
                return {name = "Steal an Egg (Detected)", module = "stealegg"}
            end
        end
        
        return {name = "Unknown Game", module = "universal"}
    end
    
    return gameData
end

