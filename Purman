        ESPColor = Color3.fromRGB(255, 100, 100),
        AntiAfk = true,
    }
    local C = getgenv().BF
    
    -- Anti AFK
    if C.AntiAfk then
        LP.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
    
    -- Core functions
    local function TeleportTo(pos)
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then root.CFrame = CFrame.new(pos + Vector3.new(0, 5, 0)) end
    end
    
    local function GetNearestMob(range)
        range = range or 150
        local char = LP.Character
        if not char then return nil end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        
        local nearest, nd = nil, range
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= char then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local d = (hrp.Position - root.Position).Magnitude
                    if d < nd then nd = d; nearest = obj end
                end
            end
        end
        return nearest
    end
    
    local function AttackMob(mob)
        if not mob then return end
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if not root or not mobRoot then return end
        
        root.CFrame = CFrame.new(mobRoot.Position + Vector3.new(0, 5, 0), mobRoot.Position)
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end
    
    -- Farm loop
    RunService.Heartbeat:Connect(function()
        if C.AutoFarm then
            local mob = GetNearestMob(150)
            if mob then AttackMob(mob) end
