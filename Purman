local function LoadStealEggModule()
    SouGPT.LOADED_MODULES.stealegg = true
    
    getgenv().SE = {
        AutoSteal = false, StealRange = 15, StealDelay = 0.3,
        AutoPlace = false, AutoHatch = false,
        ESP = false, ESPColor = Color3.fromRGB(255, 200, 0),
        SpeedEnabled = false, SpeedValue = 100,
        FlyEnabled = false, FlySpeed = 120, Noclip = false,
        ReturnToBase = true, BasePosition = nil,
        AntiAfk = true,
    }
    local C = getgenv().SE
    
    -- Anti AFK
    if C.AntiAfk then
        LP.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
    
    -- Egg detection
    local function GetAllEggPrompts()
        local prompts = {}
        local function scan(obj)
            if obj:IsA("ProximityPrompt") then
                local a = obj.ActionText:lower()
                local o = obj.ObjectText:lower()
                if a:find("steal") or a:find("egg") or a:find("take") or o:find("egg") then
                    table.insert(prompts, obj)
                end
            end
            for _, c in ipairs(obj:GetChildren()) do scan(c) end
        end
        scan(workspace)
        return prompts
    end
    
    local function GetClosestEgg()
        local closest, shortest = nil, C.StealRange
        local char = LP.Character
        if not char then return nil end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        for _, p in ipairs(GetAllEggPrompts()) do
            local part = p.Parent
            if part and part:IsA("BasePart") then
                local d = (part.Position - root.Position).Magnitude
                if d < shortest then shortest = d; closest = p end
            end
        end
        return closest
    end
    
    local function GetPlacePrompt()
        local char = LP.Character
        if not char then return nil end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local a = obj.ActionText:lower()
                if a:find("place") or a:find("hatch") or a:find("incubat") then
                    local part = obj.Parent
                    if part and part:IsA("BasePart") then
                        local d = (part.Position - root.Position).Magnitude
                        if d < 25 then return obj end
                    end
                end
            end
        end
        return nil
    end
    
    local lastSteal = 0
    local stolenEggs = 0
    
    local function StealEgg(prompt)
        if not prompt then return end
        local now = tick()
        if now - lastSteal < C.StealDelay then return end
        lastSteal = now
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration or 0.1)
            prompt:InputHoldEnd()
        end)
        stolenEggs = stolenEggs + 1
    end
    
    -- Anti-cheat: namecall hook
    pcall(function()
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", function(self, ...)
            local m = getnamecallmethod()
            if m == "FireServer" then
                local s = tostring(self):lower()
                if s:find("kick") or s:find("anticheat") then return end
            end
            return oldNC(self, ...)
        end)
    end)
    
    -- Fly
    local flyConn = nil
    local function ToggleFly(state)
        C.FlyEnabled = state
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        
        if state then
            local bv = Instance.new("BodyVelocity", root)
            bv.Name = "SGPT_Fly"; bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Velocity = Vector3.zero
            local bg = Instance.new("BodyGyro", root)
            bg.Name = "SGPT_Gyro"; bg.MaxTorque = Vector3.new(1e5,1e5,1e5); bg.P = 1000; bg.CFrame = root.CFrame
            hum.PlatformStand = true
            
            flyConn = RunService.RenderStepped:Connect(function()
                if not C.FlyEnabled then return end
                local mv = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv += Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv -= Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv -= Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv += Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0,1,0) end
                bv.Velocity = mv.Magnitude > 0 and mv.Unit * C.FlySpeed or Vector3.zero
                bg.CFrame = Camera.CFrame
            end)
        else
            if flyConn then flyConn:Disconnect() flyConn = nil end
            local bv = root:FindFirstChild("SGPT_Fly")
            local bg = root:FindFirstChild("SGPT_Gyro")
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
            hum.PlatformStand = false
        end
    end
    
    -- ESP
    local ESPObjects = {}
    RunService.RenderStepped:Connect(function()
        if not Drawing then return end
        for _, esp in pairs(ESPObjects) do
            esp.box.Visible = false
            esp.text.Visible = false
        end
        
        if C.ESP then
            for _, p in ipairs(GetAllEggPrompts()) do
                local part = p.Parent
                if part and part:IsA("BasePart") then
                    if not ESPObjects[part] then
                        local box = Drawing.new("Square")
                        box.Thickness = 1.5; box.Color = C.ESPColor; box.Filled = false
                        local text = Drawing.new("Text")
                        text.Size = 13; text.Color = Color3.fromRGB(255,255,255)
                        text.Center = true; text.Outline = true; text.OutlineColor = Color3.fromRGB(0,0,0)
                        ESPObjects[part] = {box = box, text = text}
                    end
                    local esp = ESPObjects[part]
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local d = (part.Position - Camera.CFrame.Position).Magnitude
                        local size = math.clamp(300/d, 8, 60)
                        esp.box.Size = Vector2.new(size, size)
                        esp.box.Position = Vector2.new(pos.X - size/2, pos.Y - size/2)
                        esp.box.Visible = true
                        esp.text.Text = "🥚 " .. string.format("%.0fm", d)
                        esp.text.Position = Vector2.new(pos.X, pos.Y - size/2 - 16)
                        esp.text.Visible = true
                    end
                end
            end
        end
    end)
    
    -- Main loop
    RunService.Heartbeat:Connect(function()
        if C.AutoSteal then
            local prompt = GetClosestEgg()
            if prompt then StealEgg(prompt) end
        end
        if C.AutoPlace or C.AutoHatch then
            local p = GetPlacePrompt()
            if p then pcall(function()
                p:InputHoldBegin(); task.wait(0.1); p:InputHoldEnd()
            end) end
        end
    end)
    
    -- Speed
    RunService.Heartbeat:Connect(function()
        if C.SpeedEnabled then
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = C.SpeedValue end
        end
    end)
    
    -- UI
    local Tab = Rayfield:CreateTab("🥚 Steal an Egg", 4483362458)
    Tab:CreateSection("Auto Steal")
    Tab:CreateToggle({Name = "Auto Steal Egg", CurrentValue = false, Flag = "SE_AutoSteal",
        Callback = function(v) C.AutoSteal = v end})
    Tab:CreateSlider({Name = "Steal Range", Range = {5,50}, Increment = 1, Suffix = " stud",
        CurrentValue = 15, Flag = "SE_Range",
        Callback = function(v) C.StealRange = v end})
    Tab:CreateSlider({Name = "Steal Delay", Range = {0.1,2}, Increment = 0.1, Suffix = " s",
        CurrentValue = 0.3, Flag = "SE_Delay",
        Callback = function(v) C.StealDelay = v end})
    Tab:CreateSection("Auto Base")
    Tab:CreateToggle({Name = "Auto Place", CurrentValue = false, Flag = "SE_AutoPlace",
        Callback = function(v) C.AutoPlace = v end})
    Tab:CreateToggle({Name = "Auto Hatch", CurrentValue = false, Flag = "SE_AutoHatch",
        Callback = function(v) C.AutoHatch = v end})
    Tab:CreateSection("Movement")
    Tab:CreateToggle({Name = "Speed", CurrentValue = false, Flag = "SE_Speed",
        Callback = function(v) C.SpeedEnabled = v end})
    Tab:CreateSlider({Name = "Speed Value", Range = {16,300}, Increment = 1, Suffix = "",
        CurrentValue = 100, Flag = "SE_SpeedVal",
        Callback = function(v) C.SpeedValue = v end})
    Tab:CreateToggle({Name = "Fly (WASD+Space/Ctrl)", CurrentValue = false, Flag = "SE_Fly",
        Callback = function(v) ToggleFly(v) end})
    Tab:CreateSection("ESP")
    Tab:CreateToggle({Name = "Egg ESP", CurrentValue = false, Flag = "SE_ESP",
        Callback = function(v) C.ESP = v end})
    Tab:CreateColorPicker({Name = "ESP Color", Color = Color3.fromRGB(255,200,0), Flag = "SE_ESPColor",
        Callback = function(v) C.ESPColor = v end})
    
    Notify("🥚 Steal an Egg Module", "Loaded! Anti-cheat bypass aktif.")
