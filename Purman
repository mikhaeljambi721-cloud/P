local function LoadUniversalModule()
    SouGPT.LOADED_MODULES.universal = true
    
    getgenv().UNI = {
        Aimbot = false, FOV = 150, Smoothness = 0.15,
        AimKey = Enum.UserInputType.MouseButton2,
        TeamCheck = true, Prediction = 0.12,
        ESP = false, BoxColor = Color3.fromRGB(0,255,0),
        ShowName = true, ShowHealth = true, ShowDistance = true,
        SpeedEnabled = false, SpeedValue = 100,
        FlyEnabled = false, FlySpeed = 150,
    }
    local C = getgenv().UNI
    
    local aimHeld = false
    local ESPObjects = {}
    
    -- Aimbot
    local function GetTarget()
        local closest, shortest = nil, C.FOV * 2
        local center = Camera.ViewportSize / 2
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP or not p.Character then continue end
            if C.TeamCheck and p.Team == LP.Team then continue end
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if not head or not hum or hum.Health <= 0 then continue end
            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if not onScreen then continue end
            local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
            if d < shortest then shortest = d; closest = {pos = head.Position} end
        end
        return closest
    end
    
    RunService.RenderStepped:Connect(function()
        if C.Aimbot and aimHeld then
            local t = GetTarget()
            if t then
                local look = CFrame.lookAt(Camera.CFrame.Position, t.pos)
                Camera.CFrame = Camera.CFrame:Lerp(look, C.Smoothness)
            end
        end
    end)
    
    UserInputService.InputBegan:Connect(function(i, g)
        if g then return end
        if i.UserInputType == C.AimKey then aimHeld = true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == C.AimKey then aimHeld = false end
    end)
    
    -- ESP
    RunService.RenderStepped:Connect(function()
        if not Drawing then return end
        for _, esp in pairs(ESPObjects) do
            esp.box.Visible = false; esp.text.Visible = false
        end
        if not C.ESP then return end
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP or not p.Character then continue end
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if not head or not hum then continue end
            
            if not ESPObjects[p] then
                local box = Drawing.new("Square")
                box.Thickness = 1.5; box.Color = C.BoxColor; box.Filled = false
                local text = Drawing.new("Text")
                text.Size = 13; text.Color = Color3.fromRGB(255,255,255)
                text.Center = true; text.Outline = true; text.OutlineColor = Color3.fromRGB(0,0,0)
                ESPObjects[p] = {box = box, text = text}
            end
            
            local esp = ESPObjects[p]
            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local d = (head.Position - Camera.CFrame.Position).Magnitude
                local size = math.clamp(400/d, 15, 100)
                esp.box.Size = Vector2.new(size*0.5, size)
                esp.box.Position = Vector2.new(pos.X - size*0.25, pos.Y - size*0.5)
                esp.box.Visible = true
                
                local label = ""
                if C.ShowName then label = p.Name end
                if C.ShowHealth then label = label .. " [" .. math.floor(hum.Health) .. "]" end
                if C.ShowDistance then label = label .. string.format(" %.0fm", d) end
                esp.text.Text = label
                esp.text.Position = Vector2.new(pos.X, pos.Y - size*0.5 - 16)
                esp.text.Visible = true
            end
        end
    end)
    
    -- UI
    local Tab = Rayfield:CreateTab("🎯 Universal", 4483362458)
    Tab:CreateSection("Aimbot")
    Tab:CreateToggle({Name = "Aimbot", CurrentValue = false, Flag = "UNI_Aimbot",
        Callback = function(v) C.Aimbot = v end})
    Tab:CreateSlider({Name = "FOV", Range = {10,500}, Increment = 5, Suffix = " px",
        CurrentValue = 150, Flag = "UNI_FOV",
        Callback = function(v) C.FOV = v end})
    Tab:CreateSlider({Name = "Smoothness", Range = {0,1}, Increment = 0.01, Suffix = "",
        CurrentValue = 0.15, Flag = "UNI_Smooth",
        Callback = function(v) C.Smoothness = v end})
    Tab:CreateSection("ESP")
    Tab:CreateToggle({Name = "ESP", CurrentValue = false, Flag = "UNI_ESP",
        Callback = function(v) C.ESP = v end})
    Tab:CreateToggle({Name = "Show Name", CurrentValue = true, Flag = "UNI_Name",
        Callback = function(v) C.ShowName = v end})
    Tab:CreateToggle({Name = "Show Health", CurrentValue = true, Flag = "UNI_Health",
        Callback = function(v) C.ShowHealth = v end})
    Tab:CreateToggle({Name = "Show Distance", CurrentValue = true, Flag = "UNI_Dist",
        Callback = function(v) C.ShowDistance = v end})
    
