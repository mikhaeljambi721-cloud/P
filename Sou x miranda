local function TeleportToBest()
    local best = GetBestEgg()
    if not best then
        Rayfield:Notify({Title="SouGPT",Content="Tidak ada egg terdeteksi.",Duration=2})
        return
    end
    local char = LP.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = CFrame.new(best.Position + Vector3.new(0, 3, 0))
            Rayfield:Notify({Title="SouGPT",Content="Teleport ke egg terdekat!",Duration=2})
        end
    end
end

