-- ============================================
--  🔍 EGG DETECTION
-- ============================================

local function GetAllEggPrompts()
    local prompts = {}
    local function scan(obj)
        if obj:IsA("ProximityPrompt") then
            local action = obj.ActionText:lower()
            local object = obj.ObjectText:lower()
            if action:find("steal") or action:find("egg") or
               action:find("take") or object:find("egg") then
                table.insert(prompts, obj)
            end
        end
        for _, child in ipairs(obj:GetChildren()) do
            scan(child)
        end
    end
    scan(workspace)
    return prompts
end

local function GetClosestEggPrompt()
    local closest, shortest = nil, Config.StealRange
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, prompt in ipairs(GetAllEggPrompts()) do
        local part = prompt.Parent
        if part and part:IsA("BasePart") then
            local dist = (part.Position - root.Position).Magnitude
            if dist < shortest then
                shortest = dist
                closest = prompt
            end
        end
    end
    return closest
end

local function GetBestEgg()
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, prompt in ipairs(GetAllEggPrompts()) do
        local part = prompt.Parent
        if part and part:IsA("BasePart") then
            local dist = (part.Position - root.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                best = part
            end
        end
    end
    return best
end

-- ============================================
--  🎯 AUTO STEAL
-- ============================================

local function StealEgg(prompt)
    if not prompt then return end
    local now = tick()
    if now - lastSteal < Config.StealDelay then return end
    lastSteal = now
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration or 0.1)
        prompt:InputHoldEnd()
    end)
    stolenEggs = stolenEggs + 1
    if Config.Notify then
        Rayfield:Notify({
            Title = "🥚 SouGPT",
            Content = "Egg stolen! Total: " .. stolenEggs,
            Duration = 1.5,
            Image = 4483362458
        })
    end
end

-- ============================================
--  🏠 AUTO PLACE & HATCH
-- ============================================

local function GetPlacePrompt()
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local action = obj.ActionText:lower()
            local object = obj.ObjectText:lower()
            if action:find("place") or action:find("hatch") or
               action:find("incubat") or object:find("pen") or object:find("nest") then
                local part = obj.Parent
                if part and part:IsA("BasePart") then
                    local dist = (part.Position - root.Position).Magnitude
                    if dist < 25 then return obj end
                end
            end
        end
    end
    return nil
end

-- ============================================
--  👁️ ESP
-- ============================================

local function CreateESP(part, color, label)
    if ESPObjects[part] or not Drawing then return end
    local box = Drawing.new("Square")
    box.Thickness = 1.5
    box.Color = color
    box.Filled = false
    box.Transparency = 0.7
    local text = Drawing.new("Text")
    text.Size = 13
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    ESPObjects[part] = {box = box, text = text, label = label, color = color}
end

local function UpdateESP()
    if not Drawing then return end
    
    local active = {}
    
    -- Egg ESP
    if Config.EggESP then
        for _, prompt in ipairs(GetAllEggPrompts()) do
            local part = prompt.Parent
            if part and part:IsA("BasePart") then
                active[part] = true
                if not ESPObjects[part] then CreateESP(part, Config.EggESPColor, "🥚 Egg") end
                local esp = ESPObjects[part]
                if esp then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (part.Position - Camera.CFrame.Position).Magnitude
                        local size = math.clamp(300 / dist, 8, 80)
                        esp.box.Size = Vector2.new(size, size)
                        esp.box.Position = Vector2.new(pos.X - size/2, pos.Y - size/2)
                        esp.box.Color = Config.EggESPColor
                        esp.box.Visible = true
                        esp.text.Text = "🥚 " .. string.format("%.0f", dist) .. "m"
                        esp.text.Position = Vector2.new(pos.X, pos.Y - size/2 - 16)
                        esp.text.Visible = true
                    else
                        esp.box.Visible = false
                        esp.text.Visible = false
                    end
                end
            end
        end
    end
    
    -- Player ESP
    if Config.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    active[head] = true
                    if not ESPObjects[head] then CreateESP(head, Color3.fromRGB(255, 50, 50), plr.Name) end
                    local esp = ESPObjects[head]
                    if esp then
                        local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist = (head.Position - Camera.CFrame.Position).Magnitude
                            local size = math.clamp(400 / dist, 15, 120)
                            esp.box.Size = Vector2.new(size * 0.5, size)
                            esp.box.Position = Vector2.new(pos.X - size*0.25, pos.Y - size*0.5)
                            esp.box.Visible = true
                            esp.text.Text = plr.Name .. (Config.ShowDistance and string.format(" [%.0fm]", dist) or "")
                            esp.text.Position = Vector2.new(pos.X, pos.Y - size*0.5 - 16)
                            esp.text.Visible = true
                        else
                            esp.box.Visible = false
                            esp.text.Visible = false
                        end
                    end
                end
            end
        end
    end
    
    -- Hide inactive
    for obj, esp in pairs(ESPObjects) do
        if not active[obj] then
            esp.box.Visible = false
            esp.text.Visible = false
        end
    end
end

