-- =========================================================
-- LETTER → NUMBER CONVERTER
-- =========================================================
local function num(s)
    s = tostring(s)
    local out = {}
    for i = 1, #s do
        local c = s:sub(i, i)
        local b = c:byte()
        if b >= 65 and b <= 90 then          -- A-Z
            table.insert(out, b - 64)
        elseif b >= 97 and b <= 122 then     -- a-z
            table.insert(out, b - 96)
        elseif c == " " then
            table.insert(out, 0)
        else
            table.insert(out, b)             -- simbol: pakai ASCII
        end
    end
    return table.concat(out, "-")
end

