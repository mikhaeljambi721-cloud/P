local function createESP(plr)
    if plr == LocalPlayer then return end
    if ESPFolder:FindFirstChild(plr.Name .. "_ESP") then return end

    local box = Instance.new("BoxHandleAdornment")
    box.Name = plr.Name .. "_ESP"
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Size = Vector3.new(2, 5, 2)
    box.Transparency = 0.5
    box.Color3 = Color3.fromRGB(255, 60, 60)
    box.Parent = ESPFolder

    local nameTag = Instance.new("BillboardGui")
    nameTag.Name = plr.Name .. "_Name"
    nameTag.Size = UDim2.new(0, 100, 0, 20)
    nameTag.StudsOffset = Vector3.new(0, 3, 0)
    nameTag.AlwaysOnTop = true
    nameTag.Parent = ESPFolder

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = plr.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = nameTag

    local function update()
        local char = plr.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp then
                box.Adornee = hrp
                nameTag.Adornee = hrp
                if hum then
                    local hpRatio = hum.Health / hum.MaxHealth
                    box.Color3 = Color3.fromRGB(255 * (1 - hpRatio), 255 * hpRatio, 0)
                end
            else
                box.Adornee = nil
                nameTag.Adornee = nil
            end
        else
            box.Adornee = nil
            nameTag.Adornee = nil
        end
    end

    update()
    plr.CharacterAdded:Connect(update)
    task.spawn(function()
        while box.Parent do update(); task.wait(0.1) end
    end)
end

