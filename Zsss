-- Metode 1: ProximityPrompt
local function GetEggPrompts()
    local prompts = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local a = obj.ActionText:lower()
            local o = obj.ObjectText:lower()
            if a:find("steal") or a:find("egg") or a:find("take") or o:find("egg") then
                table.insert(prompts, obj)
            end
        end
    end
    return prompts
end

-- Metode 2: ClickDetector
local function GetEggClickDetectors()
    local detectors = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            local parent = obj.Parent
            if parent and parent.Name:lower():find("egg") then
                table.insert(detectors, obj)
            end
        end
    end
    return detectors
end

-- Metode 3: Tool (egg di workspace)
local function GetEggTools()
    local tools = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Name:lower():find("egg") then
            table.insert(tools, obj)
        end
    end
    return tools
end

-- Ambil egg terdekat (multi-metode)
local function GetClosestEgg()
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local closest, shortest = nil, C.StealRange
    local method = nil
    
    -- Cek ProximityPrompt
    for _, p in ipairs(GetEggPrompts()) do
        local part = p.Parent
        if part and part:IsA("BasePart") then
            local d = (part.Position - root.Position).Magnitude
            if d < shortest then
                shortest = d
                closest = p
                method = "prompt"
            end
        end
    end
    
    -- Cek ClickDetector
    for _, cd in ipairs(GetEggClickDetectors()) do
        local part = cd.Parent
        if part and part:IsA("BasePart") then
            local d = (part.Position - root.Position).Magnitude
            if d < shortest then
                shortest = d
                closest = cd
                method = "click"
            end
        end
    end
    
    return closest, method, shortest
end

-- ============================================
--  🎯 AUTO STEAL ENGINE
-- ============================================

local lastSteal = 0
local stolenEggs = 0

local function StealEgg(target, method)
    if not target then return false end
    
    local now = tick()
    if now - lastSteal < C.StealDelay then return false end
    lastSteal = now
    
    local success = false
    
    if method == "prompt" then
        success = pcall(function()
            target:InputHoldBegin()
            task.wait(target.HoldDuration or 0.1)
            target:InputHoldEnd()
        end)
    elseif method == "click" then
        success = pcall(function()
            fireclickdetector(target)
        end)
    end
    
    if success then
        stolenEggs = stolenEggs + 1
    end
    
    return success
end

-- ============================================
--  ✈️ FLY
-- ============================================

local flyConn = nil

local function ToggleFly(state)
    C.Fly = state
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    if state then
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "SGPT_Fly"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        
        local bg = Instance.new("BodyGyro", root)
        bg.Name = "SGPT_Gyro"
        bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bg.P = 1000
        bg.CFrame = root.CFrame
        
        hum.PlatformStand = true
        
        flyConn = RunService.RenderStepped:Connect(function()
            if not C.Fly then return end
            local mv = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv += Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv -= Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv -= Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv += Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0, 1, 0) end
            bv.Velocity = mv.Magnitude > 0 and mv.Unit * C.FlySpeed or Vector3.zero
            bg.CFrame = Camera.CFrame
        end)
    else
        if flyConn then flyConn:Disconnect() flyConn = nil end
        local bv = root:FindFirstChild("SGPT_Fly")
        local bg = root:FindFirstChild("SGPT_Gyro")
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        hum.PlatformStand = false
    end
end

