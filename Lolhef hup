local function createCard(parent, order, height)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -8, 0, height or 60)
    card.BackgroundColor3 = C.card
    card.BorderSizePixel = 0
    card.LayoutOrder = order or 0
