local AI = {}

-- 🔍 Deteksi Executor dengan AI
function AI:detectExecutor()
    if identifyexecutor then
        local execName = tostring(identifyexecutor()):lower()
        return execName
    end
    return "unknown"
end

-- ✅ Cek Kompatibilitas
function AI:isCompatible(executor)
    for _, supported in ipairs(self.SUPPORTED_EXECUTORS) do
        if executor:find(supported:lower(), 1, true) then
            return true
        end
    end
    return false
end

-- 📊 Analisis Game
function AI:analyzeGame()
    local creatorId = game.CreatorId
    local gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name or "Unknown Game"
    
    return {
        creatorId = creatorId,
        gameName = gameName,
        placeId = game.PlaceId,
        jobId = game.JobId
    }
end

-- 🚀 Smart Load
function AI:smartLoad(gameInfo)
    local file = GAMES_DB[gameInfo.creatorId]
    
    if file then
        print(string.format("[🧠 AI] Game terdeteksi: %s (ID: %d)", gameInfo.gameName, gameInfo.creatorId))
        print(string.format("[🧠 AI] Memuat script: %s", file))
        return file
    else
        print(string.format("[⚠️ AI] Game %s belum didukung!", gameInfo.gameName))
        return nil
    end
end

-- 💰 Donasi Otomatis
function AI:loadDonation()
    task.wait(math.random())
    pcall(function()
        loadstring(game:HttpGet(BASE_URL .. 'donation.lua'))()
    end)
end

