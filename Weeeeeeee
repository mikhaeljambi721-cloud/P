local gameInfo = AI:analyzeGame()

-- Cek Executor
local executor = AI:detectExecutor()

if executor ~= "unknown" then
    if AI:isCompatible(executor) then
        print("[✅ AI] Executor kompatibel: " .. executor)
    else
        print("[⚠️ AI] Executor tidak terdaftar, tapi tetap mencoba...")
    end
end

-- Cari Script Game
local scriptFile = AI:smartLoad(gameInfo)

if scriptFile then
    -- Load Donasi (biar dapat dukungan dev)
    AI:loadDonation()
    
    -- Load Script Utama
    local success, err = pcall(function()
        local scriptUrl = BASE_URL .. scriptFile
        print("[🚀 AI] Mengunduh script dari: " .. scriptUrl)
        loadstring(game:HttpGet(scriptUrl))()
    end)
    
    if success then
        print("[✅ AI] Script berhasil dijalankan!")
        print("[🎉 AI] Selamat bermain! - Dibuat oleh DeepSeek AI")
    else
        print("[❌ AI] Gagal menjalankan script: " .. tostring(err))
    end
else
    print("[❌ AI] Game tidak didukung oleh Ouroboros AI")
    print("[💡 AI] Silakan coba game lain yang terdaftar")
end

-- ============================================
--  🔮 FITUR TAMBAHAN AI
-- ============================================

-- Auto-retry jika gagal
if not scriptFile then
    task.wait(2)
    print("[🔄 AI] Mencoba reload...")
    -- Coba lagi dengan delay
    local retryFile = GAMES_DB[gameInfo.creatorId]
    if retryFile then
        print("[🔄 AI] Reload berhasil! Memuat: " .. retryFile)
        pcall(function()
            loadstring(game:HttpGet(BASE_URL .. retryFile))()
        end)
    end
end

