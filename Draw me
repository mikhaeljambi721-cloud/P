-- ============================================
--  🖼️ SOUGPT IMAGE DRAWER
--  Tinggal paste link gambar, langsung muncul
--  Delta Executor Optimized
-- ============================================

if not game:IsLoaded() then game.Loaded:Wait() end

-- ============================================
--  ⚙️ KONFIGURASI — GANTI LINK DI SINI
-- ============================================

local IMAGE_URL = "https://example.com/gambar.png"  -- ← PASTE LINK GAMBAR DI SINI

local CONFIG = {
    Position = UDim2.new(0.5, 0, 0.5, 0),  -- Posisi di layar (tengah default)
    Size = UDim2.new(0, 300, 0, 300),       -- Ukuran gambar
    Draggable = true,                        -- Bisa digeser
    Transparency = 0,                        -- 0 = solid, 1 = transparan
    RemoveAfter = 0,                         -- 0 = permanen, angka = detik auto-hilang
}

-- ============================================
--  🚀 SCRIPT UTAMA
-- ============================================

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

-- Hapus GUI lama kalau ada
local oldGui = PlayerGui:FindFirstChild("SouGPT_ImageDrawer")
if oldGui then oldGui:Destroy() end

-- Buat ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SouGPT_ImageDrawer"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.IgnoreGuiInset = true
ScreenGui.Parent = PlayerGui

-- Frame utama
local Frame = Instance.new("Frame")
Frame.Name = "ImageFrame"
Frame.Size = CONFIG.Size
Frame.Position = CONFIG.Position
Frame.AnchorPoint = Vector2.new(0.5, 0.5)
Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
Frame.BorderSizePixel = 0
Frame.Active = CONFIG.Draggable
Frame.Draggable = CONFIG.Draggable
Frame.Parent = ScreenGui

-- Corner
local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 12)
Corner.Parent = Frame

-- Stroke (border)
local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(80, 80, 100)
Stroke.Thickness = 2
Stroke.Parent = Frame

-- ImageLabel
local ImageLabel = Instance.new("ImageLabel")
ImageLabel.Name = "Image"
ImageLabel.Size = UDim2.new(1, -10, 1, -10)
ImageLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
ImageLabel.AnchorPoint = Vector2.new(0.5, 0.5)
ImageLabel.BackgroundTransparency = 1
ImageLabel.Image = IMAGE_URL
ImageLabel.ImageTransparency = CONFIG.Transparency
ImageLabel.ScaleType = Enum.ScaleType.Fit
ImageLabel.Parent = Frame

-- Corner untuk image
local ImageCorner = Instance.new("UICorner")
ImageCorner.CornerRadius = UDim.new(0, 10)
ImageCorner.Parent = ImageLabel

-- Tombol Close (X)
local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0, 30, 0, 30)
CloseBtn.Position = UDim2.new(1, 5, 0, -5)
CloseBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
CloseBtn.BorderSizePixel = 0
CloseBtn.Text = "✕"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.TextSize = 18
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.Parent = Frame

local CloseCorner = Instance.new("UICorner")
CloseCorner.CornerRadius = UDim.new(0, 15)
CloseCorner.Parent = CloseBtn

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- ============================================
--  ⏱️ AUTO REMOVE (Opsional)
-- ============================================

if CONFIG.RemoveAfter > 0 then
    task.delay(CONFIG.RemoveAfter, function()
        if ScreenGui and ScreenGui.Parent then
            ScreenGui:Destroy()
        end
    end)
end

-- ============================================
--  📋 INFO
-- ============================================

print("========================================")
print("🖼️ SouGPT Image Drawer Loaded")
print("📎 URL: " .. IMAGE_URL)
print("💡 Tip: Drag gambar untuk memindahkan")
print("❌ Klik tombol X untuk menutup")
print("========================================")
