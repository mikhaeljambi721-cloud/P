-- ============================================
--  🎯 AIMBOT ENGINE
-- ============================================

local function IsVisible(part)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LP.Character, part.Parent}
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin)
    local result = workspace:Raycast(origin, direction, rayParams)
    return result == nil
end

local function GetAimTarget()
    local closest = nil
    local shortest = Config.FOV * 2
    local center = Camera.ViewportSize / 2
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LP then continue end
        if not player.Character then continue end
        
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        
        if Config.TeamCheck and player.Team == LP.Team then continue end
        
        local part = player.Character:FindFirstChild(Config.AimPart)
        if not part then continue end
        
        if Config.VisibleCheck and not IsVisible(part) then continue end
        
        -- Prediksi gerakan
        local velocity = hum.MoveDirection * hum.WalkSpeed
        local predictedPos = part.Position + (velocity * Config.Prediction)
        
        local pos, onScreen = Camera:WorldToViewportPoint(predictedPos)
        if not onScreen then continue end
        
        local delta = Vector2.new(pos.X - center.X, pos.Y - center.Y)
        local mag = delta.Magnitude
        
        if mag < shortest then
            shortest = mag
            closest = {player = player, pos = predictedPos, part = part}
        end
    end
    return closest
end

local function AimAt(target)
    if not target then return end
    local current = Camera.CFrame
    local lookAt = CFrame.lookAt(current.Position, target.pos)
    Camera.CFrame = current:Lerp(lookAt, Config.Smoothness)
end

-- ============================================
--  👁️ ESP ENGINE
-- ============================================

local function CreateESP(player)
    if ESPObjects[player] then return end
    if not Drawing then return end
    
    local box = Drawing.new("Square")
    box.Thickness = 1.5
    box.Color = Config.BoxColor
    box.Filled = false
    box.Transparency = 0.7
    
    local name = Drawing.new("Text")
    name.Size = 14
    name.Color = Color3.fromRGB(255, 255, 255)
    name.Center = true
    name.Outline = true
    name.OutlineColor = Color3.fromRGB(0, 0, 0)
    
    local health = Drawing.new("Text")
    health.Size = 12
    health.Color = Color3.fromRGB(0, 255, 0)
    health.Center = true
    health.Outline = true
    health.OutlineColor = Color3.fromRGB(0, 0, 0)
    
    local dist = Drawing.new("Text")
    dist.Size = 12
    dist.Color = Color3.fromRGB(200, 200, 200)
    dist.Center = true
    dist.Outline = true
    dist.OutlineColor = Color3.fromRGB(0, 0, 0)
    
    local tracer = Drawing.new("Line")
    tracer.Thickness = 1
    tracer.Color = Config.TracerColor
    tracer.Transparency = 0.7
    
    ESPObjects[player] = {
        box = box, name = name, health = health,
        dist = dist, tracer = tracer
    }
end

local function HideESP(esp)
    esp.box.Visible = false
    esp.name.Visible = false
    esp.health.Visible = false
    esp.dist.Visible = false
    esp.tracer.Visible = false
end

local function UpdateESP()
    if not Drawing then return end
    
    for player, esp in pairs(ESPObjects) do
        if not Config.ESP then HideESP(esp) continue end
        if player == LP or not player.Character then HideESP(esp) continue end
        
        local head = player.Character:FindFirstChild("Head")
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if not head or not root or not hum or hum.Health <= 0 then
            HideESP(esp)
            continue
        end
        
        if Config.TeamCheck and player.Team == LP.Team then HideESP(esp) continue end
        
        local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local rootPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
        
        if not onScreen then HideESP(esp) continue end
        
        local height = math.abs(headPos.Y - rootPos.Y)
        local width = height * 0.6
        local boxPos = Vector2.new(headPos.X - width/2, headPos.Y)
        
        -- Box
        if Config.BoxESP then
            esp.box.Size = Vector2.new(width, height)
            esp.box.Position = boxPos
            esp.box.Color = Config.BoxColor
            esp.box.Visible = true
        else
            esp.box.Visible = false
        end
        
        -- Name
        if Config.NameESP then
            esp.name.Text = player.Name
            esp.name.Position = Vector2.new(headPos.X, headPos.Y - 18)
            esp.name.Visible = true
        else
            esp.name.Visible = false
        end
        
        -- Health
        if Config.HealthESP then
            esp.health.Text = string.format("❤ %d", math.floor(hum.Health))
            esp.health.Position = Vector2.new(headPos.X, headPos.Y + height + 2)
            esp.health.Color = Color3.fromRGB(
                255 * (1 - hum.Health/100),
                255 * (hum.Health/100),
                0
            )
            esp.health.Visible = true
        else
            esp.health.Visible = false
        end
        
        -- Distance
        if Config.DistanceESP then
            local distance = (root.Position - Camera.CFrame.Position).Magnitude
            esp.dist.Text = string.format("[%d studs]", math.floor(distance))
            esp.dist.Position = Vector2.new(headPos.X, headPos.Y + height + 16)
            esp.dist.Visible = true
        else
            esp.dist.Visible = false
        end
        
        -- Tracer
        if Config.TracerESP then
            esp.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            esp.tracer.To = Vector2.new(headPos.X, headPos.Y + height/2)
            esp.tracer.Color = Config.TracerColor
            esp.tracer.Visible = true
        else
            esp.tracer.Visible = false
        end
    end
end

-- ============================================
--  ⭕ FOV CIRCLE
-- ============================================

local function UpdateFOVCircle()
    if not Drawing then return end
    
    if not FOVCircle then
        FOVCircle = Drawing.new("Circle")
        FOVCircle.Thickness = 1
        FOVCircle.NumSides = 60
        FOVCircle.Radius = Config.FOV
        FOVCircle.Filled = false
        FOVCircle.Transparency = 0.5
    end
    
    FOVCircle.Color = Config.FOVColor
    FOVCircle.Position = Camera.ViewportSize / 2
    FOVCircle.Radius = Config.FOV
    FOVCircle.Visible = Config.FOVCircle and Config.Aimbot
end

-- ============================================
--  🚀 MAIN LOOP
-- ============================================

RunService.RenderStepped:Connect(function()
    -- Aimbot
    if Config.Aimbot and aimKeyHeld then
        local target = GetAimTarget()
        if target then AimAt(target) end
    end
    
    -- ESP
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            if not ESPObjects[player] then CreateESP(player) end
        end
    end
    UpdateESP()
    
    -- FOV Circle
    UpdateFOVCircle()
end)

-- ============================================
--  🖱️ INPUT HANDLER
-- ============================================

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Config.AimKey then
        aimKeyHeld = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Config.AimKey then
        aimKeyHeld = false
    end
end)

-- ============================================
--  👥 PLAYER HANDLING
-- ============================================

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(1)
        if not ESPObjects[player] then CreateESP(player) end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            obj:Remove()
        end
        ESPObjects[player] = nil
    end
end)

for _, player in pairs(Players:GetPlayers()) do
    if player ~= LP then
        CreateESP(player)
    end
end

