-- 3. NOCLIP
createToggle("Noclip", false, function(state)
    State.Noclip = state
    task.spawn(function()
        while State.Noclip do
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
            task.wait(0.2)
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end)
end)

-- 4. ESP EGG (deteksi objek bernama "Egg")
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "EggESP"
ESPFolder.Parent = game.CoreGui

local function createEggESP(obj)
    if not obj or not obj:IsA("BasePart") then return end
    if ESPFolder:FindFirstChild(obj.Name .. tostring(obj:GetDebugId())) then return end

    local box = Instance.new("BoxHandleAdornment")
    box.Name = obj.Name .. tostring(obj:GetDebugId())
    box.Adornee = obj
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Size = obj.Size
    box.Transparency = 0.6
    box.Color3 = Color3.fromRGB(255, 220, 0)
    box.Parent = ESPFolder
end

createToggle("ESP Egg", false, function(state)
    State.ESP = state
    if state then
        task.spawn(function()
            while State.ESP do
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and (obj.Name:lower():find("egg")) then
                        createEggESP(obj)
                    end
                end
                task.wait(2)
            end
            ESPFolder:ClearAllChildren()
        end)
    else
        ESPFolder:ClearAllChildren()
    end
end)

-- 5. AUTO STEAL (deteksi telur terdekat & teleport ke situ)
createToggle("Auto Steal (Telur Terdekat)", false, function(state)
    State.AutoSteal = state
    task.spawn(function()
        while State.AutoSteal do
            local hrp = getHRP()
            if hrp then
                local closest, dist = nil, math.huge
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name:lower():find("egg") and obj.Parent then
                        local d = (hrp.Position - obj.Position).Magnitude
                        if d < dist and d < 200 then
                            closest, dist = obj, d
                        end
                    end
                end
                if closest then
                    hrp.CFrame = CFrame.new(closest.Position + Vector3.new(0, 3, 0))
                end
            end
            task.wait(0.5)
        end
    end)
end)

-- 6. AUTO HATCH (spam klik tombol hatch kalau ada)
createToggle("Auto Hatch (Auto Klik)", false, function(state)
    State.AutoHatch = state
    task.spawn(function()
        while State.AutoHatch do
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            if playerGui then
                for _, gui in pairs(playerGui:GetDescendants()) do
                    if gui:IsA("TextButton") then
                        local txt = gui.Text:lower()
                        if txt:find("hatch") or txt:find("open") then
                            pcall(function() gui:Activate() end)
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end)

-- 7. TELEPORT KE TELUR TERDEKAT (manual)
createButton("⚡ Teleport ke Telur Terdekat", function()
    local hrp = getHRP()
    if not hrp then return end
    local closest, dist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
            local d = (hrp.Position - obj.Position).Magnitude
            if d < dist then closest, dist = obj, d end
        end
    end
    if closest then
        hrp.CFrame = CFrame.new(closest.Position + Vector3.new(0, 3, 0))
    end
end)

