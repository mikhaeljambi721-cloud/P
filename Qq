if not game:IsLoaded() then game.Loaded:Wait() end

-- ============================================
--  🔐 KEY DATABASE
-- ============================================

local KEYS = {
    ["ganteng"]    = {duration = 3600,  name = "1 Jam"},
    ["key 1 hari"] = {duration = 86400, name = "1 Hari"},
    ["1 menit"]    = {duration = 60,    name = "1 Menit"},
}

local SAVE_FILE = "SouGPT_Premium_Key.json"

-- ============================================
--  💾 KEY SAVE/LOAD
-- ============================================

local HttpService = game:GetService("HttpService")

local function SaveKeyData(key, expireTime)
    pcall(function()
        if writefile then
            writefile(SAVE_FILE, HttpService:JSONEncode({
                key = key, expire = expireTime, savedAt = os.time()
            }))
        end
    end)
end

local function LoadKeyData()
    if not isfile or not readfile then return nil end
    if not isfile(SAVE_FILE) then return nil end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(SAVE_FILE))
    end)
    return (ok and data and data.expire) and data or nil
end

local function ValidateKey(key)
    key = key:lower():gsub("^%s+", ""):gsub("%s+$", "")
    return KEYS[key], key
end

local function IsKeyValid()
    local data = LoadKeyData()
    if not data then return false end
    if os.time() >= data.expire then return false end
    return true, data
end

local function FormatTime(seconds)
    if seconds <= 0 then return "Expired" end
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    if h > 0 then return string.format("%dh %dm", h, m) end
    if m > 0 then return string.format("%dm %ds", m, s) end
    return string.format("%ds", s)
end

