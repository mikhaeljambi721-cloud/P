local Drawing = Drawing or debug.getupvalue(getrenv().Drawing, 1) or Drawing

-- ============================================
--  🎯 FUNGSI BUILD MENU UTAMA
-- ============================================

local function BuildMainMenu(keyData)
    local keyInfo = KEYS[keyData.key] or {name = "Unknown"}
    local sisaWaktu = keyData.expire - os.time()
    
    -- ========== MAIN WINDOW ==========
    local Window = Rayfield:CreateWindow({
        Name = "🔑 SouGPT Premium | " .. keyInfo.name,
        LoadingTitle = "Memuat SouGPT Premium...",
        LoadingSubtitle = "Key: " .. keyInfo.name .. " | Sisa: " .. FormatTime(sisaWaktu),
        Theme = "DarkBlue",
        ConfigurationSaving = {
            Enabled = true,
            FolderName = "SouGPT_Premium",
            FileName = "Config"
        },
        KeySystem = false
    })
    
    -- ========== VARIABEL STATE ==========
    local aimHeld = false
    local flyConn, noclipConn, speedConn, mainLoopConn = nil, nil, nil, nil
    local FOVCircle = nil
    local ESPObjects = {}
    
    -- ========== AIMBOT FUNCTIONS ==========
    local function GetAimTarget()
        local closest, shortest = nil, Config.FOV * 2
        local center = Camera.ViewportSize / 2
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP or not p.Character then continue end
            if Config.TeamCheck and p.Team == LP.Team then continue end
            local part = p.Character:FindFirstChild(Config.AimPart)
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if not part or not hum or hum.Health <= 0 then continue end
            local vel = hum.MoveDirection * hum.WalkSpeed
            local predPos = part.Position + (vel * Config.Prediction)
            local pos, onScreen = Camera:WorldToViewportPoint(predPos)
            if not onScreen then continue end
            local delta = Vector2.new(pos.X - center.X, pos.Y - center.Y)
            if delta.Magnitude < shortest then
                shortest = delta.Magnitude
                closest = {pos = predPos}
            end
        end
        return closest
    end
    
    -- ========== ESP FUNCTIONS ==========
    local function CreateESP(player)
        if ESPObjects[player] or not Drawing then return end
        local box = Drawing.new("Square")
        box.Thickness = 1.5; box.Filled = false; box.Transparency = 0.7
        
        local name = Drawing.new("Text")
        name.Size = 14; name.Color = Color3.fromRGB(255,255,255)
        name.Center = true; name.Outline = true
        name.OutlineColor = Color3.fromRGB(0,0,0)
        
        local health = Drawing.new("Text")
        health.Size = 12; health.Center = true; health.Outline = true
        health.OutlineColor = Color3.fromRGB(0,0,0)
        
        local dist = Drawing.new("Text")
        dist.Size = 12; dist.Color = Color3.fromRGB(200,200,200)
        dist.Center = true; dist.Outline = true
        dist.OutlineColor = Color3.fromRGB(0,0,0)
        
        local tracer = Drawing.new("Line")
        tracer.Thickness = 1; tracer.Transparency = 0.7
        
        ESPObjects[player] = {box=box, name=name, health=health, dist=dist, tracer=tracer}
    end
    
    local function HideESP(esp)
        for _, o in pairs(esp) do o.Visible = false end
    end
    
    -- ========== FLY ==========
    local function ToggleFly(state)
        Config.FlyEnabled = state
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        
        if state then
            local bv = Instance.new("BodyVelocity", root)
            bv.Name = "SGPT_Fly"; bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Velocity = Vector3.zero
            local bg = Instance.new("BodyGyro", root)
            bg.Name = "SGPT_Gyro"; bg.MaxTorque = Vector3.new(1e5,1e5,1e5); bg.P = 1000; bg.CFrame = root.CFrame
            hum.PlatformStand = true
            flyConn = RunService.RenderStepped:Connect(function()
                if not Config.FlyEnabled then return end
                local mv = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv += Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv -= Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv -= Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv += Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0,1,0) end
                bv.Velocity = mv.Magnitude > 0 and mv.Unit * Config.FlySpeed or Vector3.zero
                bg.CFrame = Camera.CFrame
            end)
        else
            if flyConn then flyConn:Disconnect() flyConn = nil end
            local bv = root:FindFirstChild("SGPT_Fly")
            local bg = root:FindFirstChild("SGPT_Gyro")
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
            hum.PlatformStand = false
        end
    end
    
    -- ========== NOCLIP ==========
    local function ToggleNoclip(state)
        Config.Noclip = state
        if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        if not state then return end
        noclipConn = RunService.Stepped:Connect(function()
            local char = LP.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    end
    
    -- ========== SPEED ==========
    local function ToggleSpeed(state)
        Config.SpeedEnabled = state
        if speedConn then speedConn:Disconnect() speedConn = nil end
        if not state then return end
        speedConn = RunService.Heartbeat:Connect(function()
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = Config.SpeedValue end
        end)
    end
    
    -- ========== INPUT HANDLERS ==========
    UserInputService.InputBegan:Connect(function(i, g)
        if g then return end
        if i.UserInputType == Config.AimKey then aimHeld = true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Config.AimKey then aimHeld = false end
    end)
    UserInputService.JumpRequest:Connect(function()
        if Config.InfiniteJump then
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
    
    -- ========== MAIN LOOP ==========
    mainLoopConn = RunService.RenderStepped:Connect(function()
        -- Aimbot
        if Config.Aimbot and aimHeld then
            local target = GetAimTarget()
            if target then
                local lookAt = CFrame.lookAt(Camera.CFrame.Position, target.pos)
                Camera.CFrame = Camera.CFrame:Lerp(lookAt, Config.Smoothness)
            end
        end
        
        -- FOV Circle
        if Drawing then
            if not FOVCircle then
                FOVCircle = Drawing.new("Circle")
                FOVCircle.Thickness = 1; FOVCircle.NumSides = 60
                FOVCircle.Filled = false; FOVCircle.Transparency = 0.5
            end
            FOVCircle.Color = Config.FOVColor
            FOVCircle.Position = Camera.ViewportSize / 2
            FOVCircle.Radius = Config.FOV
            FOVCircle.Visible = Config.Aimbot and Config.FOVCircle
        end
        
        -- ESP
        if Drawing then
            for player, esp in pairs(ESPObjects) do
                if not Config.ESP or player == LP or not player.Character then
                    HideESP(esp); continue
                end
                local head = player.Character:FindFirstChild("Head")
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if not head or not root or not hum or hum.Health <= 0 then
                    HideESP(esp); continue
                end
                if Config.TeamCheck and player.Team == LP.Team then
                    HideESP(esp); continue
                end
                
                local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                local rootPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
                if not onScreen then HideESP(esp); continue end
                
                local height = math.abs(headPos.Y - rootPos.Y)
                local width = height * 0.6
                
                if Config.BoxESP then
                    esp.box.Size = Vector2.new(width, height)
                    esp.box.Position = Vector2.new(headPos.X - width/2, headPos.Y)
                    esp.box.Color = Config.BoxColor
                    esp.box.Visible = true
                else esp.box.Visible = false end
                
                if Config.NameESP then
                    esp.name.Text = player.Name
                    esp.name.Position = Vector2.new(headPos.X, headPos.Y - 18)
                    esp.name.Visible = true
                else esp.name.Visible = false end
                
                if Config.HealthESP then
                    esp.health.Text = "❤ " .. math.floor(hum.Health)
                    esp.health.Position = Vector2.new(headPos.X, headPos.Y + height + 2)
                    esp.health.Color = Color3.fromRGB(255*(1-hum.Health/100), 255*(hum.Health/100), 0)
                    esp.health.Visible = true
                else esp.health.Visible = false end
                
                if Config.DistanceESP then
                    local d = (root.Position - Camera.CFrame.Position).Magnitude
                    esp.dist.Text = string.format("[%d studs]", math.floor(d))
                    esp.dist.Position = Vector2.new(headPos.X, headPos.Y + height + 16)
                    esp.dist.Visible = true
                else esp.dist.Visible = false end
                
                if Config.TracerESP then
                    esp.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                    esp.tracer.To = Vector2.new(headPos.X, headPos.Y + height/2)
                    esp.tracer.Color = Config.TracerColor
                    esp.tracer.Visible = true
                else esp.tracer.Visible = false end
            end
        end
    end)
    
    -- Auto-create ESP saat player baru masuk
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function()
            task.wait(1)
            if not ESPObjects[p] then CreateESP(p) end
        end)
    end)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then CreateESP(p) end
    end
    
    -- ========== UI TABS ==========
    
    -- TAB AIMBOT
    local AimbotTab = Window:CreateTab("🎯 Aimbot", 4483362458)
    AimbotTab:CreateSection("Aimbot Settings")
    AimbotTab:CreateToggle({Name = "Enable Aimbot", CurrentValue = false, Flag = "Aimbot",
        Callback = function(v) Config.Aimbot = v end})
    AimbotTab:CreateSlider({Name = "FOV", Range = {10,500}, Increment = 5, Suffix = " px",
        CurrentValue = 150, Flag = "FOV", Callback = function(v) Config.FOV = v end})
    AimbotTab:CreateSlider({Name = "Smoothness", Range = {0,1}, Increment = 0.01, Suffix = "",
        CurrentValue = 0.15, Flag = "Smooth", Callback = function(v) Config.Smoothness = v end})
    AimbotTab:CreateSlider({Name = "Prediction", Range = {0,0.5}, Increment = 0.01, Suffix = " s",
        CurrentValue = 0.12, Flag = "Prediction", Callback = function(v) Config.Prediction = v end})
    AimbotTab:CreateDropdown({Name = "Aim Part",
        Options = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso"},
        CurrentOption = {"Head"}, Flag = "AimPart",
        Callback = function(o) Config.AimPart = o[1] end})
    AimbotTab:CreateSection("Filter")
    AimbotTab:CreateToggle({Name = "Team Check", CurrentValue = true, Flag = "TeamCheck",
        Callback = function(v) Config.TeamCheck = v end})
    
    -- TAB ESP
    local ESPTab = Window:CreateTab("👁️ ESP", 4483362458)
    ESPTab:CreateSection("ESP Toggle")
    ESPTab:CreateToggle({Name = "Enable ESP", CurrentValue = false, Flag = "ESP",
        Callback = function(v) Config.ESP = v end})
    ESPTab:CreateSection("ESP Elements")
    ESPTab:CreateToggle({Name = "Box ESP", CurrentValue = true, Flag = "BoxESP",
        Callback = function(v) Config.BoxESP = v end})
    ESPTab:CreateToggle({Name = "Name ESP", CurrentValue = true, Flag = "NameESP",
        Callback = function(v) Config.NameESP = v end})
    ESPTab:CreateToggle({Name = "Health ESP", CurrentValue = true, Flag = "HealthESP",
        Callback = function(v) Config.HealthESP = v end})
    ESPTab:CreateToggle({Name = "Distance ESP", CurrentValue = true, Flag = "DistanceESP",
        Callback = function(v) Config.DistanceESP = v end})
    ESPTab:CreateToggle({Name = "Tracer ESP", CurrentValue = false, Flag = "TracerESP",
        Callback = function(v) Config.TracerESP = v end})
    ESPTab:CreateSection("Colors")
    ESPTab:CreateColorPicker({Name = "Box Color", Color = Color3.fromRGB(0,255,0), Flag = "BoxColor",
        Callback = function(v) Config.BoxColor = v end})
    ESPTab:CreateColorPicker({Name = "Tracer Color", Color = Color3.fromRGB(255,255,255), Flag = "TracerColor",
        Callback = function(v) Config.TracerColor = v end})
    
    -- TAB MOVEMENT
    local MoveTab = Window:CreateTab("🏃 Movement", 4483362458)
    MoveTab:CreateSection("Fly")
    MoveTab:CreateToggle({Name = "Fly (WASD+Space/Ctrl)", CurrentValue = false, Flag = "Fly",
        Callback = function(v) ToggleFly(v) end})
    MoveTab:CreateSlider({Name = "Fly Speed", Range = {20,300}, Increment = 10, Suffix = "",
        CurrentValue = 120, Flag = "FlySpeed", Callback = function(v) Config.FlySpeed = v end})
    MoveTab:CreateSection("Noclip")
    MoveTab:CreateToggle({Name = "Noclip", CurrentValue = false, Flag = "Noclip",
        Callback = function(v) ToggleNoclip(v) end})
    MoveTab:CreateSection("Speed")
    MoveTab:CreateToggle({Name = "Speed Enabled", CurrentValue = false, Flag = "Speed",
        Callback = function(v) ToggleSpeed(v) end})
    MoveTab:CreateSlider({Name = "Speed Value", Range = {16,500}, Increment = 1, Suffix = "",
        CurrentValue = 100, Flag = "SpeedVal", Callback = function(v) Config.SpeedValue = v end})
    MoveTab:CreateSection("Jump")
    MoveTab:CreateToggle({Name = "Infinite Jump", CurrentValue = false, Flag = "InfJump",
        Callback = function(v) Config.InfiniteJump = v end})
    
    -- TAB VISUAL
    local VisualTab = Window:CreateTab("🔮 Visual", 4483362458)
    VisualTab:CreateSection("FOV Circle")
    VisualTab:CreateToggle({Name = "Show FOV Circle", CurrentValue = true, Flag = "FOVCircle",
        Callback = function(v) Config.FOVCircle = v end})
    VisualTab:CreateColorPicker({Name = "FOV Color", Color = Color3.fromRGB(255,255,255), Flag = "FOVColor",
        Callback = function(v) Config.FOVColor = v end})
    
    -- TAB INFO
    local InfoTab = Window:CreateTab("ℹ️ Info", 4483362458)
    InfoTab:CreateSection("Status Key")
    InfoTab:CreateParagraph({
        Title = "Premium User",
        Content = "Key: " .. keyInfo.name ..
                  "\nExpired: " .. os.date("%d/%m/%Y %H:%M:%S", keyData.expire) ..
                  "\nSisa Waktu: " .. FormatTime(sisaWaktu)
    })
    InfoTab:CreateSection("Kontrol")
    InfoTab:CreateParagraph({
        Title = "Keybind",
        Content = "Aimbot: Klik Kanan (MouseButton2)\nFly: WASD + Space/Ctrl"
    })
    InfoTab:CreateButton({
        Name = "🚪 Logout (Hapus Key)",
        Callback = function()
            if delfile then delfile(SAVE_FILE) end
            Rayfield:Notify({Title="🚪 Logout", Content="Key dihapus. Rejoin untuk login ulang.", Duration=3})
        end
    })
    
    -- ========== AUTO-KICK SAAT EXPIRED ==========
    task.spawn(function()
        while task.wait(10) do
            local valid, data = IsKeyValid()
            if not valid then
                Rayfield:Notify({
                    Title = "⏰ Key Expired",
                    Content = "Waktu habis! Script akan berhenti.",
                    Duration = 5
                })
                task.wait(3)
                
                -- Cleanup
                if flyConn then flyConn:Disconnect() end
                if noclipConn then noclipConn:Disconnect() end
                if speedConn then speedConn:Disconnect() end
                if mainLoopConn then mainLoopConn:Disconnect() end
                for _, esp in pairs(ESPObjects) do
                    for _, o in pairs(esp) do pcall(function() o:Remove() end) end
                end
                if FOVCircle then pcall(function() FOVCircle:Remove() end) end
                pcall(function() Rayfield:Destroy() end)
                print("⏰ Key expired. Script terminated.")
                return
            end
        end
    end)
    
    -- Notifikasi sukses
    Rayfield:Notify({
        Title = "🔑 SouGPT Premium",
        Content = "Login: " .. keyInfo.name .. " | Sisa: " .. FormatTime(sisaWaktu),
        Duration = 5,
        Image = 4483362458
    })
    
    print("========================================")
    print("🔑 SOUGPT PREMIUM HUB - ACTIVE")
    print("✅ Key: " .. keyInfo.name)
    print("⏰ Sisa: " .. FormatTime(sisaWaktu))
    print("========================================")
end

-- ============================================
--  🚀 CEK KEY & TAMPILKAN UI
-- ============================================

local valid, keyData = IsKeyValid()

if valid then
    -- Key masih aktif → langsung buka menu
    print("✅ Key valid ditemukan, membuka menu...")
    BuildMainMenu(keyData)
else
    -- Belum ada key / expired → tampilkan login
    print("🔐 Belum ada key valid, tampilkan login...")
    
    local LoginWindow = Rayfield:CreateWindow({
        Name = "🔑 SouGPT Premium | Login",
        LoadingTitle = "Menunggu Login...",
        LoadingSubtitle = "Masukkan key untuk membuka menu",
        Theme = "DarkBlue",
        ConfigurationSaving = {Enabled = false},
        KeySystem = false
    })
    
    local LoginTab = LoginWindow:CreateTab("🔐 Login", 4483362458)
    
    LoginTab:CreateSection("Masukkan Key")
    LoginTab:CreateParagraph({
        Title = "Key yang Tersedia",
        Content = "• ganteng → 1 Jam\n• key 1 hari → 1 Hari\n• 1 menit → 1 Menit"
    })
    
    LoginTab:CreateInput({
        Name = "Key",
        PlaceholderText = "Masukkan key di sini...",
        RemoveTextAfterFocusLost = false,
        Flag = "InputKey",
        Callback = function(text)
            getgenv().InputKey = text
        end
    })
    
    LoginTab:CreateButton({
        Name = "🔓 Login & Buka Menu",
        Callback = function()
            local inputKey = getgenv().InputKey
            if not inputKey or inputKey == "" then
                Rayfield:Notify({Title="❌ Error", Content="Key kosong!", Duration=3})
                return
            end
            
            local info, cleanKey = ValidateKey(inputKey)
            if not info then
                Rayfield:Notify({Title="❌ Invalid Key", Content="Key salah atau tidak valid!", Duration=3})
                return
            end
            
            -- Simpan key
            local expireTime = os.time() + info.duration
            SaveKeyData(cleanKey, expireTime)
            
            -- Notifikasi sukses
            Rayfield:Notify({
                Title = "✅ Login Berhasil!",
                Content = "Key: " .. info.name .. " | Membuka menu...",
                Duration = 3,
                Image = 4483362458
            })
            
            task.wait(1.5)
            
            -- Destroy login window
            pcall(function() LoginWindow:Destroy() end)
            
            -- Buka menu utama (TANPA RELOAD)
            task.wait(0.5)
            BuildMainMenu({key = cleanKey, expire = expireTime})
        end
    })
end
