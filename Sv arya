local function CreateESP(part, color, name)
    if ESPObjects[part] or not Drawing then return end
    local box = Drawing.new("Square")
    box.Thickness = 1.5
    box.Color = color
    box.Filled = false
    box.Transparency = 0.7
    
    local text = Drawing.new("Text")
    text.Size = 13
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    
    ESPObjects[part] = {box = box, text = text, name = name}
end

local function UpdateESP()
    if not Drawing then return end
    
    -- Reset
    for _, esp in pairs(ESPObjects) do
        esp.box.Visible = false
        esp.text.Visible = false
    end
    
    -- Fruit ESP
    if Config.FruitESP then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj.Name:lower():find("fruit") or 
               (obj:IsA("Model") and obj.Name:lower():find("fruit")) then
                local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    if not ESPObjects[handle] then CreateESP(handle, Config.ESPColor, "🍎 " .. obj.Name) end
                    local esp = ESPObjects[handle]
                    if esp then
                        local pos, onScreen = Camera:WorldToViewportPoint(handle.Position)
                        if onScreen then
                            local dist = (handle.Position - Camera.CFrame.Position).Magnitude
                            esp.text.Text = "🍎 " .. obj.Name .. string.format(" [%.0fm]", dist)
                            esp.text.Position = Vector2.new(pos.X, pos.Y - 20)
                            esp.text.Visible = true
                        end
                    end
                end
            end
        end
    end
    
    -- Chest ESP
    if Config.ChestESP then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name:lower():find("chest") then
                local handle = obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Handle")
                if handle then
                    if not ESPObjects[handle] then CreateESP(handle, Color3.fromRGB(255, 215, 0), "📦 Chest") end
                    local esp = ESPObjects[handle]
                    if esp then
                        local pos, onScreen = Camera:WorldToViewportPoint(handle.Position)
                        if onScreen then
                            local dist = (handle.Position - Camera.CFrame.Position).Magnitude
                            esp.text.Text = "📦 Chest" .. string.format(" [%.0fm]", dist)
                            esp.text.Position = Vector2.new(pos.X, pos.Y - 20)
                            esp.text.Visible = true
                        end
                    end
                end
            end
        end
    end
    
    -- Player ESP
    if Config.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    if not ESPObjects[head] then CreateESP(head, Color3.fromRGB(0, 255, 0), plr.Name) end
                    local esp = ESPObjects[head]
                    if esp then
                        local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist = (head.Position - Camera.CFrame.Position).Magnitude
                            esp.text.Text = plr.Name .. string.format(" [%.0fm]", dist)
                            esp.text.Position = Vector2.new(pos.X, pos.Y - 20)
                            esp.text.Visible = true
                        end
                    end
                end
            end
        end
    end
end

