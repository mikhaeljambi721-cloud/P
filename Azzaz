    local KeyWindow = Rayfield:CreateWindow({
        Name = "AIM BOT SART 1.2 - Key",
        LoadingTitle = "Verifikasi Key",
        LoadingSubtitle = "Masukkan key",
        ConfigurationSaving = {Enabled = false},
