    })

    local KeyTab = KeyWindow:CreateTab("Key", 4483362458)
    local keyInput = ""
    KeyTab:CreateInput({
        Name = "Key",
        PlaceholderText = "Masukkan key di sini...",
        RemoveTextAfterFocusLost = false,
        Callback = function(text)
            keyInput = text
        end
    })

    KeyTab:CreateButton({
        Name = "Submit",
        Callback = function()
            local expiry = checkKey(keyInput)
            if expiry then
                saveKeyExpiry(expiry)
                Rayfield:Notify({
                    Title = "Berhasil",
                    Content = "Key valid! Silakan reload script.",
                    Duration = 5
                })
                KeyWindow:Destroy()
            else
                Rayfield:Notify({
                    Title = "Gagal",
                    Content = "Key salah atau kadaluarsa.",
                    Duration = 5
                })
            end
        end
    })

    return
end

