-- ============ KEY SYSTEM ============
local keyFile = "aimbot_sart_key.txt"

local function getKeyExpiry()
    if isfile and isfile(keyFile) then
        local ok, data = pcall(readfile, keyFile)
        if ok then
            local expiry = tonumber(data)
            if expiry then return expiry end
        end
    end
    return 0
end

local function saveKeyExpiry(expiry)
    if writefile then
        pcall(writefile, keyFile, tostring(expiry))
    end
end

local function checkKey(key)
    if key == "MIKAEL GANTENG1" then
        return os.time() + 3600 -- 1 jam
    elseif key == "VIP" then
        return os.time() + 8640000 -- 100 hari
    end
    return nil
end

local currentExpiry = getKeyExpiry()
local keyValid = os.time() <= currentExpiry

