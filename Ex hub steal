local function SaveBasePosition()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        Config.BasePosition = root.CFrame
        Rayfield:Notify({
            Title = "SouGPT Egg Hunter",
            Content = "Base position tersimpan!",
            Duration = 2,
            Image = 4483362458
        })
    end
end

local function TeleportToEgg(eggInfo)
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Simpan posisi base
    if not Config.BasePosition then
        Config.BasePosition = root.CFrame
    end
    
    currentTarget = eggInfo
    
    -- Teleport ke dekat egg
    local targetPos = eggInfo.position + Vector3.new(0, 3, 0)
    root.CFrame = CFrame.new(targetPos)
    
    Rayfield:Notify({
        Title = "SouGPT Egg Hunter",
        Content = "Terbang ke: " .. eggInfo.name .. " (" .. eggInfo.rarity .. ")",
        Duration = 2,
        Image = 4483362458
    })
    
    -- Steal egg
    task.wait(0.2)
    local success = pcall(function()
        eggInfo.prompt:InputHoldBegin()
        task.wait(eggInfo.prompt.HoldDuration or 0.1)
        eggInfo.prompt:InputHoldEnd()
    end)
    
    if success then
        stolenEggs = stolenEggs + 1
        if Config.NotifyOnSteal then
            Rayfield:Notify({
                Title = "🥚 Egg Stolen!",
                Content = eggInfo.name .. " | Total: " .. stolenEggs,
                Duration = 2,
                Image = 4483362458
            })
        end
    end
    
    -- Kembali ke base
    if Config.ReturnToBase and Config.BasePosition then
        task.wait(0.3)
        root.CFrame = Config.BasePosition
        Rayfield:Notify({
            Title = "SouGPT Egg Hunter",
            Content = "Kembali ke base!",
            Duration = 1.5,
            Image = 4483362458
        })
    end
    
    currentTarget = nil
end

-- ============================================
--  👁️ ESP
-- ============================================

local function CreateEggESP(part, color, name)
    if ESPObjects[part] or not Drawing then return end
    local box = Drawing.new("Square")
    box.Thickness = 1.5
    box.Color = color
    box.Filled = false
    box.Transparency = 0.7
    local text = Drawing.new("Text")
    text.Size = 13
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    ESPObjects[part] = {box = box, text = text, name = name, color = color}
end

local function UpdateESP()
    if not Drawing then return end
    
    if not Config.EggESP then
        for _, esp in pairs(ESPObjects) do
            esp.box.Visible = false
            esp.text.Visible = false
        end
        return
    end
    
    local eggs = ScanAllEggs()
    local active = {}
    
    for _, egg in ipairs(eggs) do
        local part = egg.part
        active[part] = true
        
        if not ESPObjects[part] then
            CreateEggESP(part, Config.EggESPColor, egg.name)
        end
        
        local esp = ESPObjects[part]
        if esp then
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (part.Position - Camera.CFrame.Position).Magnitude
                local size = math.clamp(300 / dist, 8, 60)
                esp.box.Size = Vector2.new(size, size)
                esp.box.Position = Vector2.new(pos.X - size/2, pos.Y - size/2)
                esp.box.Color = Config.EggESPColor
                esp.box.Visible = true
                
                local label = egg.name
                if Config.ShowEggDistance then
                    label = label .. string.format(" [%.0fm]", dist)
                end
                esp.text.Text = label
                esp.text.Position = Vector2.new(pos.X, pos.Y - size/2 - 16)
                esp.text.Visible = true
            else
                esp.box.Visible = false
                esp.text.Visible = false
            end
        end
    end
    
    for part, esp in pairs(ESPObjects) do
        if not active[part] then
            esp.box.Visible = false
            esp.text.Visible = false
        end
    end
end

-- ============================================
--  🚀 MAIN LOOP
-- ============================================

RunService.RenderStepped:Connect(function()
    UpdateESP()
end)

RunService.Heartbeat:Connect(function()
    -- Auto Steal (jika tidak ada target manual)
    if Config.AutoSteal and not currentTarget then
        local eggs = ScanAllEggs()
        if #eggs > 0 then
            local closest = eggs[1]
            local char = LP.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (closest.position - root.Position).Magnitude
                    if dist < Config.StealRange then
                        local now = tick()
                        if now - lastSteal > Config.StealDelay then
                            lastSteal = now
                            task.spawn(function()
                                TeleportToEgg(closest)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

