--  🔍 DETEKSI EGG
-- ============================================

local function GetAllEggPrompts()
    local prompts = {}
    local function scan(obj)
        if obj:IsA("ProximityPrompt") then
            local action = obj.ActionText:lower()
            local object = obj.ObjectText:lower()
            if action:find("steal") or action:find("egg") or
               action:find("take") or object:find("egg") then
                table.insert(prompts, obj)
            end
        end
        for _, child in ipairs(obj:GetChildren()) do
            scan(child)
        end
    end
    scan(workspace)
    return prompts
end

local function GetEggInfo(prompt)
    local part = prompt.Parent
    if not part or not part:IsA("BasePart") then return nil end
    
    local name = part.Name
    local objectText = prompt.ObjectText
    local actionText = prompt.ActionText
    
    -- Estimasi rarity dari nama
    local rarity = "Common"
    local lowerName = (name .. objectText):lower()
    if lowerName:find("secret") or lowerName:find("eternal") then
        rarity = "Secret"
    elseif lowerName:find("legendary") or lowerName:find("mythic") then
        rarity = "Legendary"
    elseif lowerName:find("epic") then
        rarity = "Epic"
    elseif lowerName:find("rare") then
        rarity = "Rare"
    end
    
    return {
        part = part,
        prompt = prompt,
        name = objectText ~= "" and objectText or name,
        rarity = rarity,
        position = part.Position,
    }
end

local function ScanAllEggs()
    local eggs = {}
    for _, prompt in ipairs(GetAllEggPrompts()) do
        local info = GetEggInfo(prompt)
        if info then
            table.insert(eggs, info)
        end
    end
    -- Sort by rarity
    local rarityOrder = {Secret = 1, Legendary = 2, Epic = 3, Rare = 4, Common = 5}
    table.sort(eggs, function(a, b)
        return (rarityOrder[a.rarity] or 99) < (rarityOrder[b.rarity] or 99)
    end)
    return eggs
end

-- ============================================
--  ✈️ FLY ENGINE
-- ============================================

local function StartFly()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    Config.FlyEnabled = true
    
    local bodyVel = root:FindFirstChild("SouGPT_Fly") or Instance.new("BodyVelocity")
    bodyVel.Name = "SouGPT_Fly"
    bodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = root
    
    local bodyGyro = root:FindFirstChild("SouGPT_Gyro") or Instance.new("BodyGyro")
    bodyGyro.Name = "SouGPT_Gyro"
    bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bodyGyro.P = 1000
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root
    
    hum.PlatformStand = true
    
    flyConnection = RunService.RenderStepped:Connect(function()
        if not Config.FlyEnabled then return end
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0,1,0) end
        
        if move.Magnitude > 0 then
            bodyVel.Velocity = move.Unit * Config.FlySpeed
        else
            bodyVel.Velocity = Vector3.zero
        end
        bodyGyro.CFrame = Camera.CFrame
    end)
end

local function StopFly()
    Config.FlyEnabled = false
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    local char = LP.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then
            local bv = root:FindFirstChild("SouGPT_Fly")
            local bg = root:FindFirstChild("SouGPT_Gyro")
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
        end
        if hum then hum.PlatformStand = false end
    end
end

