local function RefreshEggList()
    if eggListContainer then
        eggListContainer:Destroy()
    end
    eggButtons = {}
    
    local eggs = ScanAllEggs()
    
    eggListContainer = Instance.new("Frame")
    eggListContainer.Size = UDim2.new(1, 0, 0, #eggs * 35 + 10)
    eggListContainer.BackgroundTransparency = 1
    eggListContainer.Parent = EggPickerTab.Container or EggPickerTab
    
    for i, egg in ipairs(eggs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 30)
        btn.Position = UDim2.new(0, 5, 0, (i-1) * 35)
        btn.BackgroundColor3 = egg.rarity == "Secret" and Color3.fromRGB(255, 100, 100) or
                                egg.rarity == "Legendary" and Color3.fromRGB(255, 200, 0) or
                                egg.rarity == "Epic" and Color3.fromRGB(180, 100, 255) or
                                egg.rarity == "Rare" and Color3.fromRGB(100, 180, 255) or
                                Color3.fromRGB(80, 80, 80)
        btn.BorderSizePixel = 0
        btn.Text = "  " .. egg.name .. "  |  " .. egg.rarity
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamMedium
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = eggListContainer
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            TeleportToEgg(egg)
        end)
        
        table.insert(eggButtons, btn)
    end
end

