local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    -- Blokir kick remote
    if method == "FireServer" and tostring(self):lower():find("kick") then
