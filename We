if not game:IsLoaded() then game.Loaded:Wait() end

-- ============================================
--  ⚙️ KONFIGURASI
-- ============================================

getgenv().SouGPT_Config = {
    AutoSteal = true,
    StealRange = 15,          -- jarak deteksi egg (stud)
    StealDelay = 0.3,         -- delay antar steal (detik)
    AutoPlace = true,         -- auto taruh egg di base
    AutoHatch = true,         -- auto hatch egg
    ESP = false,              -- tampilkan egg lewat dinding
    ESPColor = Color3.fromRGB(255, 200, 0),
    Notify = true,            -- notifikasi saat berhasil
}

-- ============================================
--  📦 SERVICE & VARIABEL
-- ============================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Drawing library (Delta)
local Drawing = Drawing or debug.getupvalue(getrenv().Drawing, 1) or Drawing

-- State
local isStealing = false
local lastSteal = 0
local stolenEggs = 0

-- ============================================
--  🔍 FUNGSI DETEKSI EGG
-- ============================================

-- Cari semua ProximityPrompt yang berkaitan dengan egg
local function GetAllEggPrompts()
    local prompts = {}
    
    -- Scan workspace secara rekursif
    local function scan(obj)
        if obj:IsA("ProximityPrompt") then
            local action = obj.ActionText:lower()
            local object = obj.ObjectText:lower()
            
            -- Filter: prompt yang berkaitan dengan egg
            if action:find("steal") or action:find("egg") or 
               action:find("take") or object:find("egg") then
                table.insert(prompts, obj)
            end
        end
        
        for _, child in ipairs(obj:GetChildren()) do
            scan(child)
        end
    end
    
    scan(workspace)
    return prompts
end

-- Cari prompt egg terdekat dari player
local function GetClosestEggPrompt()
    local closest = nil
    local shortest = SouGPT_Config.StealRange
    
    local char = LP.Character
    if not char then return nil end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local prompts = GetAllEggPrompts()
    
    for _, prompt in ipairs(prompts) do
        local part = prompt.Parent
        if not part or not part:IsA("BasePart") then continue end
        
        local dist = (part.Position - root.Position).Magnitude
        if dist < shortest then
            shortest = dist
            closest = prompt
        end
    end
    
    return closest
end

-- ============================================
--  🎯 AUTO STEAL ENGINE
-- ============================================

local function StealEgg(prompt)
    if not prompt then return false end
    
    local now = tick()
    if now - lastSteal < SouGPT_Config.StealDelay then return false end
    lastSteal = now
    
    -- Trigger prompt
    local success, err = pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration or 0.1)
        prompt:InputHoldEnd()
    end)
    
    if success then
        stolenEggs = stolenEggs + 1
        if SouGPT_Config.Notify then
            print(string.format("[🥚 SouGPT] Berhasil steal egg! Total: %d", stolenEggs))
        end
        return true
    else
        -- Fallback: coba fire remote event
        pcall(function()
            local remote = prompt:FindFirstChildOfClass("RemoteEvent")
            if remote then
                remote:FireServer()
            end
        end)
    end
    
    return false
end

-- ============================================
--  🏠 AUTO PLACE & AUTO HATCH
-- ============================================

-- Cari prompt untuk place egg di base
local function GetPlacePrompt()
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    -- Cari prompt yang berkaitan dengan place/pen/incubator
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local action = obj.ActionText:lower()
            local object = obj.ObjectText:lower()
            
            if action:find("place") or action:find("hatch") or 
               action:find("incubat") or object:find("pen") or
               object:find("nest") then
                local part = obj.Parent
                if part and part:IsA("BasePart") then
                    local dist = (part.Position - root.Position).Magnitude
                    if dist < 20 then
                        return obj
                    end
                end
            end
        end
    end
    return nil
end

local function AutoPlaceAndHatch()
    if not SouGPT_Config.AutoPlace and not SouGPT_Config.AutoHatch then return end
    
    local placePrompt = GetPlacePrompt()
    if placePrompt then
        pcall(function()
            placePrompt:InputHoldBegin()
            task.wait(0.1)
            placePrompt:InputHoldEnd()
        end)
    end
end

-- ============================================
--  👁️ ESP UNTUK EGG (Opsional)
-- ============================================

local ESPObjects = {}

local function CreateEggESP(part)
    if ESPObjects[part] then return end
    if not Drawing then return end
    
    local box = Drawing.new("Box")
    box.Thickness = 1.5
    box.Color = SouGPT_Config.ESPColor
    box.Filled = false
    box.Transparency = 0.6
    
    local text = Drawing.new("Text")
    text.Size = 14
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    
    ESPObjects[part] = {box = box, text = text}
end

local function UpdateEggESP()
    if not SouGPT_Config.ESP or not Drawing then
        -- Sembunyikan semua
        for _, esp in pairs(ESPObjects) do
            esp.box.Visible = false
            esp.text.Visible = false
        end
        return
    end
    
    local prompts = GetAllEggPrompts()
    local activeParts = {}
    
    for _, prompt in ipairs(prompts) do
        local part = prompt.Parent
        if part and part:IsA("BasePart") then
            activeParts[part] = true
            
            if not ESPObjects[part] then
                CreateEggESP(part)
            end
            
            local esp = ESPObjects[part]
            if esp then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (part.Position - Camera.CFrame.Position).Magnitude
                    local size = 200 / dist
                    
                    esp.box.Size = Vector2.new(size, size)
                    esp.box.Position = Vector2.new(pos.X - size/2, pos.Y - size/2)
                    esp.box.Visible = true
                    
                    esp.text.Text = "🥚 " .. string.format("%.0f", dist) .. "m"
                    esp.text.Position = Vector2.new(pos.X, pos.Y - size/2 - 18)
                    esp.text.Visible = true
                else
                    esp.box.Visible = false
                    esp.text.Visible = false
                end
            end
        end
    end
    
    -- Sembunyikan yang sudah tidak ada
    for part, esp in pairs(ESPObjects) do
        if not activeParts[part] then
            esp.box.Visible = false
            esp.text.Visible = false
        end
    end
end

-- ============================================
--  🚀 MAIN LOOP
-- ============================================

RunService.Heartbeat:Connect(function()
    -- Auto Steal
    if SouGPT_Config.AutoSteal then
        local prompt = GetClosestEggPrompt()
        if prompt then
            StealEgg(prompt)
        end
    end
    
    -- Auto Place & Hatch
    if SouGPT_Config.AutoPlace or SouGPT_Config.AutoHatch then
        AutoPlaceAndHatch()
    end
    
    -- ESP
    UpdateEggESP()
end)

