local ESPObjects = {}

RunService.RenderStepped:Connect(function()
    if not Drawing then return end
    
    for _, esp in pairs(ESPObjects) do
        esp.box.Visible = false
        esp.text.Visible = false
    end
    
    -- Egg ESP
    if C.EggESP then
        local function DrawEgg(part)
            if not part or not part:IsA("BasePart") then return end
            if not ESPObjects[part] then
                local box = Drawing.new("Square")
                box.Thickness = 1.5
                box.Color = C.ESPColor
                box.Filled = false
                box.Transparency = 0.7
                local text = Drawing.new("Text")
                text.Size = 13
                text.Color = Color3.fromRGB(255, 255, 255)
                text.Center = true
                text.Outline = true
                text.OutlineColor = Color3.fromRGB(0, 0, 0)
                ESPObjects[part] = {box = box, text = text, type = "egg"}
            end
            local esp = ESPObjects[part]
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local d = (part.Position - Camera.CFrame.Position).Magnitude
                local size = math.clamp(300 / d, 8, 60)
                esp.box.Size = Vector2.new(size, size)
                esp.box.Position = Vector2.new(pos.X - size/2, pos.Y - size/2)
                esp.box.Color = C.ESPColor
                esp.box.Visible = true
                esp.text.Text = "🥚 " .. string.format("%.0fm", d)
                esp.text.Position = Vector2.new(pos.X, pos.Y - size/2 - 16)
                esp.text.Visible = true
            end
        end
        
        for _, p in ipairs(GetEggPrompts()) do
            if p.Parent then DrawEgg(p.Parent) end
        end
        for _, cd in ipairs(GetEggClickDetectors()) do
            if cd.Parent then DrawEgg(cd.Parent) end
        end
    end
    
    -- Player ESP
    if C.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    if not ESPObjects[head] then
                        local box = Drawing.new("Square")
                        box.Thickness = 1.5
                        box.Color = C.PlayerESPColor
                        box.Filled = false
                        local text = Drawing.new("Text")
                        text.Size = 13
                        text.Color = Color3.fromRGB(255, 255, 255)
                        text.Center = true
                        text.Outline = true
                        text.OutlineColor = Color3.fromRGB(0, 0, 0)
                        ESPObjects[head] = {box = box, text = text, type = "player"}
                    end
                    local esp = ESPObjects[head]
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local d = (head.Position - Camera.CFrame.Position).Magnitude
                        local size = math.clamp(400 / d, 15, 100)
                        esp.box.Size = Vector2.new(size * 0.5, size)
                        esp.box.Position = Vector2.new(pos.X - size*0.25, pos.Y - size*0.5)
                        esp.box.Color = C.PlayerESPColor
                        esp.box.Visible = true
                        esp.text.Text = plr.Name .. string.format(" [%.0fm]", d)
                        esp.text.Position = Vector2.new(pos.X, pos.Y - size*0.5 - 16)
                        esp.text.Visible = true
                    end
                end
            end
        end
    end
end)

