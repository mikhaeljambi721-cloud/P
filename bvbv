local SAVE_FILE = "SouGPT_Key.json"

local function SaveKey(key, expire)
    pcall(function()
        if writefile then
            writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode({key = key, expire = expire}))
        end
    end)
end

local function LoadKey()
    if not isfile or not readfile then return nil end
    if not isfile(SAVE_FILE) then return nil end
    local ok, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
    end)
    return (ok and data and data.expire) and data or nil
end

local function IsKeyValid()
    local d = LoadKey()
    if not d then return false end
    if os.time() >= d.expire then return false end
    return true, d
end

local function FormatTime(s)
    if s <= 0 then return "Expired" end
    local h = math.floor(s / 3600)
    local m = math.floor((s % 3600) / 60)
    if h > 0 then return h .. "h " .. m .. "m" end
    if m > 0 then return m .. "m " .. (s % 60) .. "s" end
    return s .. "s"
end

