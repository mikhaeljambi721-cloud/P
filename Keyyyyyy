local SAVE_FILE = "SouGPT_Premium_Key.json"

-- ============================================
--  💾 KEY VALIDATION & SAVING
-- ============================================

local function SaveKeyData(key, expireTime)
    local data = {
        key = key,
        expire = expireTime,
        savedAt = os.time()
    }
    if writefile then
        writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode(data))
    end
end

local function LoadKeyData()
    if not isfile or not readfile then return nil end
    if not isfile(SAVE_FILE) then return nil end
    
    local success, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
    end)
    
    if success and data and data.expire then
        return data
    end
    return nil
end

local function ValidateKey(key)
    key = key:lower():gsub("^%s+", ""):gsub("%s+$", "")
    return KEYS[key]
end

local function IsKeyValid()
    local data = LoadKeyData()
    if not data then return false end
    if os.time() >= data.expire then return false end
    return true, data
end

