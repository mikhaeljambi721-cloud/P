local GodCorner = Instance.new("UICorner")
GodCorner.CornerRadius = UDim.new(0, 6)
GodCorner.Parent = MainFrame

-- =====================================================
-- LOGIKA SCRIPT
-- =====================================================

local speedEnabled = false
local godEnabled = false
local currentSpeed = 16
local godConnection = nil

-- Update UI saat respawn
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    rootPart = newChar:WaitForChild("HumanoidRootPart")
    
    if speedEnabled then
        humanoid.WalkSpeed = currentSpeed
    end
end)

-- Fungsi Toggle Speed
SpeedToggleBtn.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    
    if speedEnabled then
        SpeedToggleBtn.Text = "Speed: ON"
        SpeedToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 70)
        humanoid.WalkSpeed = currentSpeed
    else
        SpeedToggleBtn.Text = "Speed: OFF"
        SpeedToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        humanoid.WalkSpeed = 16
    end
end)

-- Fungsi Apply Speed
ApplyBtn.MouseButton1Click:Connect(function()
    local input = tonumber(SpeedInput.Text)
    
    if input then
        -- Clamp max 80000
        currentSpeed = math.clamp(input, 1, 80000)
        SpeedInput.Text = tostring(currentSpeed)
        
        if speedEnabled then
            humanoid.WalkSpeed = currentSpeed
        end
    else
        SpeedInput.Text = tostring(currentSpeed)
    end
end)

-- Fungsi Toggle God Mode
GodToggleBtn.MouseButton1Click:Connect(function()
    godEnabled = not godEnabled
    
    if godEnabled then
        GodToggleBtn.Text = "God Mode: ON"
        GodToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 70)
        
        -- God Mode: Humanoid tidak bisa mati
        godConnection = RunService.Heartbeat:Connect(function()
            if humanoid and humanoid.Parent then
                humanoid.MaxHealth = math.huge
                humanoid.Health = math.huge
            end
        end)
    else
        GodToggleBtn.Text = "God Mode: OFF"
        GodToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        
        if godConnection then
            godConnection:Disconnect()
            godConnection = nil
        end
        
        -- Reset health ke normal
        if humanoid and humanoid.Parent then
            humanoid.MaxHealth = 100
            humanoid.Health = 100
        end
    end
end)

-- =====================================================
-- HANDLE RESPAWN (perbaiki referensi character)
-- =====================================================
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    rootPart = newChar:WaitForChild("HumanoidRootPart")
    
    if speedEnabled then
        humanoid.WalkSpeed = currentSpeed
    end
    
    if godEnabled and godConnection then
        godConnection:Disconnect()
        godConnection = nil
        -- Reconnect god mode
        godConnection = RunService.Heartbeat:Connect(function()
            if humanoid and humanoid.Parent then
                humanoid.MaxHealth = math.huge
                humanoid.Health = math.huge
            end
        end)
    end
end)

print("✅ GUI Loaded! Tekan X untuk menutup, drag Title Bar untuk menggeser.")
