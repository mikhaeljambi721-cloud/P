-- =====================================================
-- TOMBOL ON/OFF SPEED
-- =====================================================
local SpeedToggleBtn = Instance.new("TextButton")
SpeedToggleBtn.Size = UDim2.new(0, 240, 0, 36)
SpeedToggleBtn.Position = UDim2.new(0, 10, 0, 45)
SpeedToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
SpeedToggleBtn.BorderSizePixel = 0
SpeedToggleBtn.Text = "Speed: OFF"
SpeedToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
